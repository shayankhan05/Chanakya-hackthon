STORAGE_DRIVER="sqlite"
SQLITE_PATH=".data/compliance.sqlite"
# Separate, rebuildable public legal-source index; never replaces the business database.
LEGAL_INDEX_PATH=".data/legal-knowledge.sqlite"
# Optional server scheduler authentication; at least 32 characters. No scheduler is enabled automatically.
DEADLINE_JOB_SECRET=""
# PostgreSQL: set STORAGE_DRIVER=postgres and uncomment this URL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sme_copilot"
NEXTAUTH_URL="http://127.0.0.1:3001"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
GITHUB_ID=""
GITHUB_SECRET=""
RESEND_API_KEY=""
MAIL_FROM=""
# Local development only. Never enable on an internet-accessible dev server.
AUTH_DEV_RESET="false"
UPLOAD_PATH=".data/uploads"
# Local only. On Vercel, evidence is encrypted in PostgreSQL (EvidenceFile).
# Vercel requires STORAGE_DRIVER=postgres and a persistent DATABASE_URL.



OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/auto"
AI_PROVIDER="gemini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional dedicated financial-record encryption key: 32 random bytes, base64.
# Configure BEFORE first import. Otherwise a key is derived from NEXTAUTH_SECRET.
# Changing keys after import requires controlled re-encryption; do not reset data.
FINANCIAL_DATA_KEY=""
