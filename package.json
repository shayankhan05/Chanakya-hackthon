{
  "name": "sme-compliance-copilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint app components lib scripts tests prisma --no-warn-ignored",
    "evaluate:advisor": "tsx scripts/evaluate-advisor.mts",
    "verify:ai": "tsx scripts/verify-ai.mts",
    "test:ai": "tsx scripts/test-live-only.mts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "postcss": "^8.5.23",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0",
    "postcss-selector-parser": "^7.1.6"
  }
}
