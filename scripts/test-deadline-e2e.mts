import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {blankProfile} from '../lib/domain';
const base=process.env.TEST_BASE_URL||'http://127.0.0.1:3001';
class Client{
 cookies=new Map<string,string>();
 async request(path:string,options:RequestInit={}){const headers=new Headers(options.headers);headers.set('origin',base);headers.set('cookie',[...this.cookies].map(([k,v])=>k+'='+v).join('; '));const r=await fetch(base+path,{...options,headers,redirect:'manual'});for(const c of r.headers.getSetCookie()){const part=c.split(';')[0],i=part.indexOf('=');this.cookies.set(part.slice(0,i),part.slice(i+1));}return r;}
 async json(path:string,method='GET',body?:unknown){const r=await this.request(path,{method,headers:{'Content-Type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});return {status:r.status,data:await r.json()};}
}
const a=new Client(),anon=new Client(),suffix=randomUUID().slice(0,8),email=`deadline-test-${suffix}@example.test`,password='Tax-test-password-12345';
assert.equal((await a.json('/api/account/signup','POST',{name:'Deadline test owner',email,password,confirmPassword:password})).status,201);
const csrf=(await a.json('/api/auth/csrf')).data.csrfToken;await a.request('/api/auth/callback/credentials',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({email,password,csrfToken:csrf,json:'true',callbackUrl:base+'/dashboard'})});assert.ok((await a.json('/api/auth/session')).data.user);
const profile={...structuredClone(blankProfile),name:'Deadline Integration Test '+suffix,state:'Karnataka',city:'Bengaluru',gst:true,employees:8,turnover:1800000,investment:400000,branchLocations:[{state:'Karnataka',city:'Bengaluru',employees:8}],eligibleEsiEmployees:4,priorEpf:'No',priorEsi:'No',epfExempt:'Unknown',taxableSupplies:'Yes',gstExceptions:'No',interstate:'No',seasonalFactory:'No',hazardous:'No'};
const created=await a.json('/api/workspaces','POST',profile);assert.equal(created.status,201,JSON.stringify(created.data));let w=created.data.workspace;

import {loadWorkspace,saveWorkspace} from '../lib/repository';
import {attachDeadlineVerification,indiaDate,daysBetween} from '../lib/deadlines';
const user=(await a.json('/api/auth/session')).data.user;
const today=indiaDate(),shift=(n:number)=>new Date(Date.parse(today+'T00:00:00Z')+n*86400000).toISOString().slice(0,10),due=shift(-3),onTime=shift(-4);
async function mutate(mutation:unknown){const r=await a.json('/api/workspaces/'+w.id,'PATCH',{revision:w.revision,mutation});assert.equal(r.status,200,JSON.stringify(r.data));w=r.data.workspace;}
await mutate({type:'new-obligation',ruleId:'GST',title:'TEST ONLY — fictional nil GSTR-3B date',period:'Synthetic test period',targetDate:shift(-5),legalDueDate:due,sourceReference:'Synthetic date fixture — not an actual filing calendar.'});
let task=w.tasks.at(-1);assert.equal(task.timeline.verified,false);assert.notEqual(task.status,'Overdue');console.log('PASS owner-proposed date remains unverified');
const raw=await loadWorkspace(user.id,w.id),t=raw.tasks.find(t=>t.id===task.id)!;
Object.assign(t,attachDeadlineVerification(t,{dueDate:due,ruleId:'GST',jurisdiction:'India',law:'CGST Act section 47 — TEST FIXTURE',provision:'TEST ONLY reviewed fictional date; no claim this is a government due date',sourceUrl:'https://gstcouncil.gov.in/node/4305',verifiedAt:today,reviewedThrough:today,reviewer:'Synthetic integration reviewer',version:'test-1',applicabilityConfirmed:true,extensionsChecked:true,consequenceRuleId:'GST-NIL-CENTRAL-2021',consequenceVersion:'1',obligationType:'GSTR-3B',nilReturn:true,taxPeriod:'2026-09',reliefChecked:true}));await saveWorkspace(user.id,raw,raw.revision,'test-fixture-review');
// A fresh sign-in, with no task-details navigation, must expose the warning.
a.cookies.clear();const nextCsrf=(await a.json('/api/auth/csrf')).data.csrfToken;await a.request('/api/auth/callback/credentials',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({email,password,csrfToken:nextCsrf,json:'true',callbackUrl:base+'/dashboard'})});assert.ok((await a.json('/api/auth/session')).data.user);
const dashboard=await a.request('/dashboard');assert.equal(dashboard.status,200);const html=await dashboard.text();assert.match(html,/Legal due dates need your attention/);assert.match(html,/Overdue by 3 days/);console.log('PASS automatic warning on opening dashboard after login');
w=(await a.json('/api/workspaces/'+w.id)).data.workspace;task=w.tasks.find((t:{id:string})=>t.id===task.id);assert.equal(task.status,'Overdue');assert.equal(task.timeline.daysOverdue,3);const noticeCount=w.notices.length;
w=(await a.json('/api/workspaces/'+w.id)).data.workspace;assert.equal(w.notices.length,noticeCount);console.log('PASS automatic status and notification deduplication');
for(const status of ['Overdue','Completed']){const r=await a.json('/api/workspaces/'+w.id,'PATCH',{revision:w.revision,mutation:{type:'task',id:task.id,status,assignee:'Owner',targetDate:task.targetDate,legalDueDate:due,sourceReference:task.sourceReference}});assert.equal(r.status,400)}console.log('PASS manual overdue and completed API flags rejected');
const report=(await a.json('/api/workspaces/'+w.id+'/report?format=json')).data;assert.equal(report.deadlineReviews.find((r:{id:string})=>r.id===task.id).deadline.daysOverdue,3);
const chat=await a.json('/api/chat','POST',{businessId:w.id,question:'Which of my deadlines are overdue?',messageId:randomUUID()});assert.equal(chat.status,200);assert.match(chat.data.message,/Overdue by 3 days/);w=chat.data.workspace;console.log('PASS report and chatbot use the same timeline');
await mutate({type:'notice',id:'all',read:true});assert.equal(w.tasks.find((t:{id:string})=>t.id===task.id).status,'Overdue');await mutate({type:'acknowledge-review',id:task.id});assert.equal(w.tasks.find((t:{id:string})=>t.id===task.id).status,'Overdue');console.log('PASS acknowledging does not close obligation');
await mutate({type:'completion',id:task.id,completedOn:onTime,declaration:'Synthetic owner declares the action was completed before the fictional deadline.',remarks:'No government filing is represented.',evidenceIds:[]});task=w.tasks.find((t:{id:string})=>t.id===task.id);assert.equal(task.timeline.status,'Completed on time');assert.equal(task.completion.state,'Declared by owner');assert.equal(w.notices.filter((n:{active:boolean;key:string})=>n.active&&n.key.endsWith(':overdue')).length,0);console.log('PASS on-time declaration transitions overdue warning without claiming verified compliance');
const body=new FormData();body.set('taskId',task.id);body.set('file',new File([new TextEncoder().encode('%PDF-1.4\nSynthetic integration fixture\n%%EOF')],'synthetic-acknowledgement.pdf',{type:'application/pdf'}));const upload=await a.request('/api/workspaces/'+w.id+'/evidence',{method:'POST',body});assert.equal(upload.status,200);w=(await upload.json()).workspace;task=w.tasks.find((t:{id:string})=>t.id===task.id);assert.equal(task.completion.completedOn,onTime);assert.equal(task.completion.state,'Proof submitted');assert.equal(task.timeline.completionState,'Proof submitted');assert.equal(task.timeline.status,'Completed on time');assert.equal(indiaDate(w.documents.at(-1).uploadedAt),today);assert.ok(daysBetween(task.completion.completedOn,indiaDate(w.documents.at(-1).uploadedAt))>0);console.log('PASS late evidence upload preserves earlier action date');
const file=w.documents.at(-1);assert.equal((await a.request('/api/workspaces/'+w.id+'/evidence/'+file.id)).status,200);assert.equal((await anon.request('/api/workspaces/'+w.id+'/evidence/'+file.id)).status,401);console.log('PASS evidence access remains private');
const bad=new FormData();bad.set('taskId',task.id);bad.set('file',new File(['<svg><script>bad</script></svg>'],'bad.svg',{type:'image/svg+xml'}));assert.equal((await a.request('/api/workspaces/'+w.id+'/evidence',{method:'POST',body:bad})).status,400);console.log('PASS active image formats rejected');
assert.ok([401,503].includes((await anon.json('/api/jobs/deadlines','POST')).status));console.log('PASS scheduled endpoint is protected or disabled');
const {writeFileSync,unlinkSync}=await import('node:fs');const {spawnSync}=await import('node:child_process');const {join}=await import('node:path');const {tmpdir}=await import('node:os');const reviewFile=join(tmpdir(),'deadline-review-'+suffix+'.json');
try{for(const action of ['review-proof','confirm-fulfilled']){writeFileSync(reviewFile,JSON.stringify({ownerId:user.id,businessId:w.id,taskId:task.id,reviewer:'Synthetic trusted reviewer',note:'Reviewed synthetic declaration and test acknowledgement only.',action}));const child=spawnSync(process.execPath,['node_modules/tsx/dist/cli.mjs','scripts/review-obligation.mts',reviewFile],{cwd:process.cwd(),encoding:'utf8'});assert.equal(child.status,0,child.stderr);w=(await a.json('/api/workspaces/'+w.id)).data.workspace;task=w.tasks.find((t:{id:string})=>t.id===task.id);assert.equal(task.completion.state,action==='review-proof'?'Proof reviewed':'Obligation confirmed fulfilled');}assert.equal(w.notices.filter((n:{active:boolean;key:string})=>n.active&&n.key.endsWith(':completion-review')&&n.key.includes(task.id)).length,0);console.log('PASS trusted proof review and fulfillment confirmation remain separate stages');}finally{unlinkSync(reviewFile)}
console.log('Deadline HTTP integration checks passed. Only synthetic records were modified.');


