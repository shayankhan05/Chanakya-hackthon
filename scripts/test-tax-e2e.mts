import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {blankProfile} from '../lib/domain';
const base=process.env.TEST_BASE_URL||'http://127.0.0.1:3001';
class Client{
 cookies=new Map<string,string>();
 async request(path:string,options:RequestInit={}){const headers=new Headers(options.headers);headers.set('origin',base);headers.set('cookie',[...this.cookies].map(([k,v])=>k+'='+v).join('; '));const r=await fetch(base+path,{...options,headers,redirect:'manual'});for(const c of r.headers.getSetCookie()){const part=c.split(';')[0],i=part.indexOf('=');this.cookies.set(part.slice(0,i),part.slice(i+1));}return r;}
 async json(path:string,method='GET',body?:unknown){const r=await this.request(path,{method,headers:{'Content-Type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});return {status:r.status,data:await r.json()};}
}
const a=new Client(),anon=new Client(),suffix=randomUUID().slice(0,8),email=`tax-test-${suffix}@example.test`,password='Tax-test-password-12345';
assert.equal((await a.json('/api/account/signup','POST',{name:'Tax test owner',email,password,confirmPassword:password})).status,201);
const csrf=(await a.json('/api/auth/csrf')).data.csrfToken;await a.request('/api/auth/callback/credentials',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({email,password,csrfToken:csrf,json:'true',callbackUrl:base+'/dashboard'})});assert.ok((await a.json('/api/auth/session')).data.user);
const profile={...structuredClone(blankProfile),name:'Phoenix Tax Test '+suffix,state:'Karnataka',city:'Bengaluru',employees:8,turnover:1800000,investment:400000,branchLocations:[{state:'Karnataka',city:'Bengaluru',employees:8}],eligibleEsiEmployees:4,priorEpf:'No',priorEsi:'No',epfExempt:'Unknown',taxableSupplies:'Yes',gstExceptions:'No',interstate:'No',seasonalFactory:'No',hazardous:'No'};
const created=await a.json('/api/workspaces','POST',profile);assert.equal(created.status,201,JSON.stringify(created.data));let w=created.data.workspace;
const before=JSON.stringify({profile:w.profile,tasks:w.tasks,events:w.events,resources:w.resources});
const config=(await a.json('/api/chat')).data;assert.equal(config.liveConfigured,false,'Do not spend provider credits in this local-mode test.');
const gst={kind:'gst',date:'2026-10-25',registered:'Yes',supply:'Services',supplierState:'Karnataka',placeOfSupply:'Karnataka',treatment:'ordinary',specialScheme:false,reverseCharge:false,classificationConfirmed:false,lines:[{description:'Illustrative software service',classification:'',amount:'10000',inclusive:false,rate:'18'}],credit:{igst:'0',cgst:'0',sgst:'0'},creditConfirmed:false};
async function calc(input:unknown){const r=await a.json('/api/calculations','POST',{businessId:w.id,input});assert.equal(r.status,200,JSON.stringify(r.data));return r.data.result;}
let r=await calc(gst);assert.equal(r.breakdown.find((b:{label:string})=>b.label==='Output GST').amount,'1800.00');console.log('PASS authenticated GST exclusive');
r=await calc({...gst,lines:[{...gst.lines[0],amount:'11800',inclusive:true}]});assert.equal(r.breakdown.find((b:{label:string})=>b.label==='Taxable value').amount,'10000.00');console.log('PASS GST inclusive');
r=await calc({...gst,placeOfSupply:'Maharashtra'});assert.equal(r.breakdown.find((b:{label:string})=>b.label==='IGST').amount,'1800.00');console.log('PASS IGST');
r=await calc({...gst,credit:{igst:'900',cgst:'900',sgst:'0'},creditConfirmed:true});assert.equal(r.breakdown.find((b:{label:string})=>b.label==='Estimated cash liability').amount,'0.00');console.log('PASS credit allocation');
r=await calc({kind:'income',taxpayer:'LLP',financialYear:'2025-26',regime:'ordinary',taxableIncome:'1000000',adjustmentsConfirmed:true,ordinaryIncomeOnly:true});assert.equal(r.breakdown.at(-1).amount,'312000.00');console.log('PASS supported income tax');
const payroll={kind:'payroll',scheme:'EPF',date:'2026-10-01',covered:true,eligible:true,wageBase:'15000',parametersConfirmed:true,rate:'12',epsEligible:true,epsWageBase:'15000',averageDailyWage:'500',continuingEsiPeriod:false};r=await calc(payroll);assert.equal(r.breakdown.find((b:{label:string})=>b.label==='Employee EPF').amount,'1800.00');r=await calc({...payroll,scheme:'ESI',wageBase:'20000'});assert.equal(r.breakdown.find((b:{label:string})=>b.label==='Employer ESI').amount,'650.00');console.log('PASS EPF and ESI');
assert.equal((await anon.json('/api/calculations','POST',{businessId:w.id,input:gst})).status,401);assert.equal((await a.json('/api/calculations','POST',{businessId:'not-owned',input:gst})).status,404);assert.equal((await a.json('/api/calculations','POST',{businessId:w.id,input:{...gst,lines:[{...gst.lines[0],rate:'999'}]}})).status,400);console.log('PASS calculation authorization and validation');
const sources=await a.json('/api/legal-sources?businessId='+w.id+'&q='+encodeURIComponent('GST credit'));assert.equal(sources.status,200);assert.ok(sources.data.records.some((r:{record:{id:string}})=>r.record.id==='GST-CREDIT'));console.log('PASS indexed legal source retrieval');
for(const [question,pattern] of [
 ['What is MSME?',/investment.*turnover/i],['What is GST?',/supplies|indirect tax/i],['I made ₹10,000 profit. How much GST do I pay?',/Profit alone is insufficient/i],['Calculate GST on ₹10,000 taxable IT services at an assumed 18%.',/Output GST: ₹1800.00/],['Does my employee count change GST?',/hiring|employee.*alone/i],['Which registrations might I need in Karnataka?',/jurisdiction review/],['What is my current annual turnover?',/18,00,000/],['What happens if I hire 50 additional employees?',/8 → 58/],['How much GST on ₹10,000 worth of software services?',/What GST rate/],['At an assumed 18% exclusive',/Output GST: ₹1800.00/],['What if my taxable sales are ₹1 lakh?',/Output GST: ₹18000.00/],['How much GST is included in a ₹11,800 bill at 18%?',/Output GST: ₹1800.00/]
] as const){const res=await a.json('/api/chat','POST',{question,messageId:randomUUID(),businessId:w.id,conversationId:w.conversationId||'legacy'});assert.equal(res.status,200,JSON.stringify(res.data));assert.match(res.data.message,pattern,question+'\n'+res.data.message);assert.equal(res.data.mode,'knowledge-base');w=res.data.workspace;console.log('PASS chat: '+question);}
const saved=(await a.json('/api/workspaces/'+w.id)).data.workspace;assert.equal(JSON.stringify({profile:saved.profile,tasks:saved.tasks,events:saved.events,resources:saved.resources}),before);console.log('PASS no business data mutations; live provider calls zero');
