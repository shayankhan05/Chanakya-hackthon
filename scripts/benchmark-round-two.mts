import {writeFile,mkdir} from 'node:fs/promises';
import {benchmarkScenarios} from '../lib/planning/benchmark-scenarios';
import {optimizePlan,deadlineOrderPlan,checkSchedule} from '../lib/planning/solver';
import {bruteForceOracle} from '../lib/planning/oracle';
import {growthTransitionChecks} from '../lib/growth-transition-checks';
const fixtures=benchmarkScenarios();for(const s of fixtures){deadlineOrderPlan(s.input);optimizePlan(s.input);}
const rows=fixtures.map(s=>{const a=performance.now(),baseline=deadlineOrderPlan(s.input),baselineMs=performance.now()-a;const optimized=optimizePlan(s.input),oracle=bruteForceOracle(s.input);if(oracle.feasible!==s.expectedFeasible||optimized.status==='feasible'!==s.expectedFeasible||(oracle.feasible&&optimized.advisoryValue!==oracle.advisoryValue))throw Error('Benchmark/oracle disagreement: '+s.id);return {id:s.id,expectedFeasible:s.expectedFeasible,reason:s.reason,baseline:{...checkSchedule(s.input,baseline),advisoryValue:baseline.filter(t=>!t.mandatory).reduce((n,t)=>n+s.input.tasks.find(a=>a.id===t.taskId)!.importance,0),elapsedMs:baselineMs},optimizer:{...checkSchedule(s.input,optimized.schedule),status:optimized.status,optimal:optimized.optimal,advisoryValue:optimized.advisoryValue,elapsedMs:optimized.elapsedMs,nodes:optimized.nodes},oracle};});
const sum=(f:(r:typeof rows[number])=>number)=>rows.reduce((n,r)=>n+f(r),0),growth=growthTransitionChecks();
if(growth.some(r=>!r.passed))throw Error('A manually specified growth transition failed.');
const summary={scenarios:rows.length,knownFeasible:rows.filter(r=>r.expectedFeasible).length,knownInfeasible:rows.filter(r=>!r.expectedFeasible).length,baselineValidSchedules:rows.filter(r=>r.baseline.valid).length,optimizerValidSchedules:rows.filter(r=>r.optimizer.valid).length,feasibleMandatoryInstances:sum(r=>r.expectedFeasible?r.optimizer.mandatoryTotal:0),baselineMandatorySatisfiedFeasible:sum(r=>r.expectedFeasible?r.baseline.mandatorySatisfied:0),optimizerMandatorySatisfiedFeasible:sum(r=>r.expectedFeasible?r.optimizer.mandatorySatisfied:0),baselineMandatorySatisfied:sum(r=>r.baseline.mandatorySatisfied),optimizerMandatorySatisfied:sum(r=>r.optimizer.mandatorySatisfied),mandatoryTaskInstances:sum(r=>r.optimizer.mandatoryTotal),baselineInfeasibleInputsFlagged:rows.filter(r=>!r.expectedFeasible&&!r.baseline.valid).length,optimizerProvenInfeasible:rows.filter(r=>r.optimizer.status==='infeasible').length,baselineFeasibleInputsRejected:rows.filter(r=>r.expectedFeasible&&!r.baseline.valid).length,optimizerFeasibleInputsRejected:rows.filter(r=>r.expectedFeasible&&!r.optimizer.valid).length,comparableCompleteInputs:rows.filter(r=>r.baseline.valid&&r.optimizer.valid).length,baselineComparableAdvisoryValue:sum(r=>r.baseline.valid&&r.optimizer.valid?r.baseline.advisoryValue:0),optimizerComparableAdvisoryValue:sum(r=>r.baseline.valid&&r.optimizer.valid?r.optimizer.advisoryValue:0),baselineDependencyViolations:sum(r=>r.baseline.dependencyViolations),optimizerDependencyViolations:sum(r=>r.optimizer.dependencyViolations),baselineBudgetUsed:sum(r=>Number(r.baseline.budgetUsed)),optimizerBudgetUsed:sum(r=>Number(r.optimizer.budgetUsed)),baselineHoursUsed:sum(r=>r.baseline.hoursUsed),optimizerHoursUsed:sum(r=>r.optimizer.hoursUsed),baselineTotalMs:sum(r=>r.baseline.elapsedMs),optimizerTotalMs:sum(r=>r.optimizer.elapsedMs),oracleMatches:rows.length,growthChecksPassed:growth.filter(r=>r.passed).length,growthChecks:growth.length};
const report={generatedAt:new Date().toISOString(),fixture:'25 fictional constraint problems, not measured SME outcomes. Costs and deadlines are examples.',summary,rows,growth};await writeFile('docs/round-two-benchmark.json',JSON.stringify(report,null,2)+'\n');
const md=`# Round-two deterministic benchmark\n\nGenerated ${report.generatedAt}. All 25 scenarios use fictional costs, availability and finish windows. These are algorithm tests, not legal accuracy measurements or measured business outcomes.\n\n| Measure | Deadline-order baseline | Constraint-aware optimizer |\n|---|---:|---:|\n| Valid complete schedules (out of ${summary.knownFeasible} feasible inputs) | ${summary.baselineValidSchedules} | ${summary.optimizerValidSchedules} |\n| Mandatory finish windows satisfied (feasible inputs only) | ${summary.baselineMandatorySatisfiedFeasible}/${summary.feasibleMandatoryInstances} | ${summary.optimizerMandatorySatisfiedFeasible}/${summary.feasibleMandatoryInstances} |\n| Infeasible inputs flagged (${summary.knownInfeasible} total) | ${summary.baselineInfeasibleInputsFlagged} greedy failures, not proofs | ${summary.optimizerProvenInfeasible} mathematical infeasibility results |\n| Feasible inputs rejected | ${summary.baselineFeasibleInputsRejected} | ${summary.optimizerFeasibleInputsRejected} |\n| Optional importance on the ${summary.comparableCompleteInputs} inputs where both completed all required work | ${summary.baselineComparableAdvisoryValue} | ${summary.optimizerComparableAdvisoryValue} |\n| Dependency violations in returned schedules | ${summary.baselineDependencyViolations} | ${summary.optimizerDependencyViolations} |\n| Aggregate budget used (example rupees) | ${summary.baselineBudgetUsed.toFixed(2)} | ${summary.optimizerBudgetUsed.toFixed(2)} |\n| Aggregate hours scheduled | ${summary.baselineHoursUsed} | ${summary.optimizerHoursUsed} |\n| Total solver time on this run (ms) | ${summary.baselineTotalMs.toFixed(3)} | ${summary.optimizerTotalMs.toFixed(3)} |\n\nThe baseline chooses earliest-deadline ready tasks, respects staff capacity, dependencies, budget and available hours, and can consume resources on optional work before mandatory work. A greedy failure is not proof that the input is infeasible. The optimizer takes mandatory tasks and prerequisite closure as hard constraints, then maximizes user-entered advisory importance. It returns no partial schedule as a feasible solution when mandatory work is impossible. Thus aggregate spending is not a like-for-like cost-saving measure: the baseline sometimes returns incomplete plans. Neither method has any dependency violations on this fixture set; no improvement is claimed on that metric.\n\nAll ${summary.oracleMatches} cases agree with an independent tiny-dataset exhaustive oracle on feasibility and optimal advisory value. ${summary.growthChecksPassed}/${summary.growthChecks} separately specified screening transitions passed. Transition expectations were reviewed for consistency with the current local rules; they are not independent legal advice or a new source-freshness audit.\n\n## Scenario results\n\n| Scenario | Expected | Baseline complete | Optimizer | Nodes | ms |\n|---|---|---|---|---:|---:|\n${rows.map(r=>`| ${r.id} | ${r.expectedFeasible?'Feasible':'Infeasible'} | ${r.baseline.valid?'Yes':'No'} | ${r.optimizer.status} | ${r.optimizer.nodes} | ${r.optimizer.elapsedMs.toFixed(3)} |`).join('\n')}\n\n## Limits\n\nExact discrete model: at most 12 tasks, 3 responsible people, 14 working days, whole-hour tasks and 50,000 search nodes. Tasks retain one person and consecutive declared working slots, pausing only outside their working hours. Larger sets are rejected, and a search-limit outcome is explicitly not an infeasibility proof. Equally valued schedules are resolved by deterministic traversal; minimum cost or minimum completion time is not a second optimization objective. Both methods were warmed up on all fixtures before timing. Timings vary with hardware and load. No LLM calls were made for this benchmark.\n`;
await writeFile('docs/ROUND-TWO-BENCHMARK.md',md);console.log(JSON.stringify(summary,null,2));

await mkdir('public',{recursive:true});await writeFile('public/round-two-benchmark.json',JSON.stringify(report,null,2)+'\n');
const html='<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ComplianceCopilot round-two benchmark</title><style>body{font:15px/1.7 system-ui,sans-serif;color:#183355;background:#f6f8fc;margin:0;padding:35px}main{max-width:1080px;margin:auto;background:white;padding:35px;border:1px solid #dce4ee;border-radius:12px}h1{font-size:30px;line-height:1.3}table{border-collapse:collapse;width:100%;font-size:12px}td,th{padding:10px;text-align:left;border-bottom:1px solid #e2e8f0}th{background:#f0f4fa}.metrics{display:flex;gap:30px;flex-wrap:wrap;margin:25px 0}.metrics strong{font-size:28px;display:block}small{color:#6d8099}code{background:#f0f4fa;padding:3px 6px}@media print{body{padding:0;background:white}main{padding:15px;border:0}}</style><main><small>SRUJANA 2026 · LS-01 THE GROWTH TRAP</small><h1>Constraint-aware planning: measured results</h1><p>25 fictional scenarios. Example costs and finish windows. No Gemini calls. These are algorithm benchmarks, not legal accuracy claims.</p><div class="metrics"><div><strong>'+summary.optimizerValidSchedules+'/'+summary.knownFeasible+'</strong>feasible inputs solved</div><div><strong>'+summary.optimizerProvenInfeasible+'/'+summary.knownInfeasible+'</strong>infeasible inputs proved</div><div><strong>'+summary.oracleMatches+'/25</strong>independent oracle matches</div></div><p>Deadline-order scheduling built '+summary.baselineValidSchedules+' complete schedules and rejected '+summary.baselineFeasibleInputsRejected+' inputs that had feasible solutions. On feasible inputs it satisfied '+summary.baselineMandatorySatisfiedFeasible+'/'+summary.feasibleMandatoryInstances+' mandatory finish windows, versus '+summary.optimizerMandatorySatisfiedFeasible+'/'+summary.feasibleMandatoryInstances+' for the optimizer. Both methods returned zero dependency violations.</p><p>Total measured time after warm-up: baseline '+summary.baselineTotalMs.toFixed(3)+' ms; optimizer '+summary.optimizerTotalMs.toFixed(3)+' ms. Timings vary by hardware and load. '+summary.growthChecksPassed+'/'+summary.growthChecks+' separately specified local rule transitions passed.</p><p>Aggregate example spending: baseline ₹'+summary.baselineBudgetUsed+', optimizer ₹'+summary.optimizerBudgetUsed+'. Hours scheduled: '+summary.baselineHoursUsed+' versus '+summary.optimizerHoursUsed+'. These are not comparable savings figures because the baseline sometimes returned incomplete plans.</p><div style="overflow:auto"><table><thead><tr><th>Fictional scenario</th><th>Expected</th><th>Baseline complete</th><th>Optimizer</th><th>Time ms</th></tr></thead><tbody>'+rows.map(r=>'<tr><td>'+r.id+'</td><td>'+(r.expectedFeasible?'Feasible':'Infeasible')+'</td><td>'+(r.baseline.valid?'Yes':'No')+'</td><td>'+r.optimizer.status+'</td><td>'+r.optimizer.elapsedMs.toFixed(3)+'</td></tr>').join('')+'</tbody></table></div><h2>What is proven</h2><p>Mandatory tasks and dependencies are hard constraints. Selected tasks respect budget, work hours, declared staffing and finish windows. The exact discrete search maximizes user-entered advisory importance. Tie-breaking is deterministic; minimum cost and makespan are not additional objectives.</p><h2>Scope and limits</h2><p>Up to 12 tasks, 3 people, 14 days and 50,000 nodes. Whole-hour durations. Tasks keep one person across consecutive available working slots and pause outside working hours. Larger inputs are rejected; reaching the node limit means optimality or feasibility may be unknown. An LLM cannot override the solver.</p><p><a href="/round-two-benchmark.json">Download full benchmark data</a> · <a href="/demo#simulator">Open the isolated judge demonstration</a></p><small>Measured run: '+report.generatedAt+'</small></main></html>';
await writeFile('public/round-two-benchmark.html',html);
