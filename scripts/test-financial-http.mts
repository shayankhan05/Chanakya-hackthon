const base=process.env.TEST_BASE_URL||'http://127.0.0.1:3001',results:{check:string;passed:boolean}[]=[];
class Client{cookies=new Map<string,string>();async request(path:string,options:RequestInit={}){const headers=new Headers(options.headers);headers.set('origin',base);headers.set('cookie',[...this.cookies].map(([k,v])=>k+'='+v).join('; '));const r=await fetch(base+path,{...options,headers,redirect:'manual',signal:AbortSignal.timeout(45000)});for(const c of r.headers.getSetCookie()){const p=c.split(';')[0],n=p.indexOf('=');this.cookies.set(p.slice(0,n),p.slice(n+1));}return r;}async json(path:string,method='GET',data?:unknown){const r=await this.request(path,{method,headers:{'Content-Type':'application/json'},body:data===undefined?undefined:JSON.stringify(data)});return {status:r.status,data:await r.json()};}}
function pass(check:string){results.push({check,passed:true});console.log('PASS '+check);}
async function owner(){const c=new Client(),email='finance-http-'+randomUUID().slice(0,8)+'@example.test',password='Fixture-'+randomBytes(18).toString('hex');assert.equal((await c.json('/api/account/signup','POST',{name:'Isolated Financial Test',email,password,confirmPassword:password})).status,201);const csrf=(await c.json('/api/auth/csrf')).data.csrfToken;await c.request('/api/auth/callback/credentials',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({csrfToken:csrf,email,password,json:'true',callbackUrl:base+'/dashboard'})});assert.ok((await c.json('/api/auth/session')).data.user);const w=await c.json('/api/workspaces','POST',demoWorkspace('judge').profile);assert.equal(w.status,201);return {c,w:w.data.workspace,loginAgain:async()=>{const fresh=new Client(),token=(await fresh.json('/api/auth/csrf')).data.csrfToken;await fresh.request('/api/auth/callback/credentials',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({csrfToken:token,email,password,json:'true',callbackUrl:base+'/dashboard'})});assert.ok((await fresh.json('/api/auth/session')).data.user);return fresh;}};}
const a=await owner(),b=await owner(),path='/api/financial-records?businessId='+a.w.id,initial=structuredClone(a.w);
async function upload(bytes:Uint8Array,name:string,mime:string,revision:number,consent='yes',from='2026-04-01',to='2026-09-30'){const body=new FormData();body.set('file',new Blob([new Uint8Array(bytes)],{type:mime}),name);body.set('consent',consent);body.set('account','Fictional operating');body.set('from',from);body.set('to',to);body.set('revision',String(revision));const r=await a.c.request(path,{method:'POST',body});const text=await r.text();if(r.status===413&&!text)return {status:413,data:{error:'Request too large (transport rejection).'}};let data;try{data=JSON.parse(text);}catch{throw Error(`Invalid financial response (HTTP ${r.status}, ${text.length} bytes).`);}return {status:r.status,data};}
assert.equal((await new Client().json(path)).status,401);pass('Unauthenticated financial access rejected');assert.equal((await b.c.json(path)).status,404);pass('Cross-business reads rejected');
