const fresh=await a.loginAgain(),reloaded=await fresh.json(path);assert.equal(reloaded.status,200);assert.equal(reloaded.data.imports[0].confirmed,true);assert.equal(reloaded.data.summary.projection.projectedSales,'4200000.00');assert.equal(reloaded.data.summary.months[0].salesReceipts,'350000.00');pass('Confirmed records and calculations persist after a fresh authenticated login and reload');
const dashboardSummary=(await fresh.json(path+'&summary=1')).data;assert.equal(dashboardSummary.hasRecords,true);assert.equal(dashboardSummary.summary.reviewTasks.filter((t:{title:string})=>t.title.includes('GST')).length,1);assert.ok(dashboardSummary.summary.warnings.length);pass('Dashboard summary supplies the same financial figures warnings and generated review tasks');
const figureFields={action:'figure',financialYear:'2025-26',definition:'Owner reconciled invoice supplies',reference:'Fictional supporting invoice record'};
for(const amount of ['-1','1.001','abc'])assert.equal((await a.c.json(path,'PATCH',{...figureFields,revision:view.revision,amount})).status,400);pass('Invalid negative nonnumeric and excess-precision figure inputs show validation errors');
assert.equal((await a.c.json(path,'PATCH',{...figureFields,financialYear:'2026-28',revision:view.revision,amount:'1'})).status,400);pass('Invalid consecutive financial year is rejected');
for(const amount of ['0','₹1,23,456.78','.50']){r=await a.c.json(path,'PATCH',{...figureFields,revision:view.revision,amount});assert.equal(r.status,200);view=r.data;assert.equal(view.summary.confirmedSupplyFigure.financialYear,'2025-26');assert.equal(view.summary.ownerDeclaredTurnover,'1800000.00');}assert.equal(view.summary.confirmedSupplyFigure.amount,'0.50');pass('Zero Indian-grouped rupees and fractional decimals save against the explicitly selected year');

assert.equal((await a.c.json(path,'PATCH',{action:'confirm',revision:0,importId,changes,coverageConfirmed:true})).status,409);pass('Stale financial writes rejected');
const weighted=await a.c.json(path+'&method=weighted');assert.equal(weighted.data.summary.projection.projectedSales,'4200000.00');pass('Weighted method executes on server');
const variant=csv.replace('Date,Description','Transaction Date,Narration');r=await upload(Buffer.from(variant),'overlap.csv','text/csv',view.revision);assert.equal(r.status,200);assert.equal(r.data.added,0);assert.equal(r.data.transactions.length,36);view=r.data;const overlapId=r.data.importId;pass('Overlapping import reuses 36 transactions');
r=await upload(textStatementPDF(pdfExampleLines),'supported.pdf','application/pdf',view.revision);assert.equal(r.status,200);assert.equal(r.data.added,2);view=r.data;pass('Actual text PDF endpoint and worker extraction');
assert.equal((await upload(textStatementPDF(['unsupported layout']),'unsupported.pdf','application/pdf',view.revision)).status,400);assert.equal((await upload(Buffer.from('not pdf'),'fake.pdf','application/pdf',view.revision)).status,400);pass('Unsupported PDF and false PDF signatures rejected');
assert.equal((await upload(Buffer.alloc(2300000),'large.csv','text/csv',view.revision)).status,413);pass('Oversized body rejected before parsing');
assert.equal((await b.c.json(path,'DELETE',{action:'import',id:importId,revision:view.revision})).status,404);pass('Cross-business deletion rejected');
r=await a.c.json(path,'DELETE',{action:'import',id:overlapId,revision:view.revision});assert.equal(r.status,200);assert.equal((await a.c.request(path+'&file='+overlapId)).status,404);view=r.data;pass('Statement deletion removes the downloadable file and preserves shared rows');
r=await a.c.json(path,'DELETE',{action:'transaction',id:view.transactions[0].id,revision:view.revision});assert.equal(r.status,200);assert.equal(r.data.summary.projection.projectedSales,null);view=r.data;pass('Deleting a transaction invalidates completeness and forecast');
r=await a.c.json(path,'PATCH',{action:'figure',revision:view.revision,amount:'1900000.25',financialYear:'2026-27',definition:'Owner reviewed invoice sales figure',reference:'FICTIONAL invoice reconciliation'});assert.equal(r.status,200);assert.equal(r.data.summary.confirmedSupplyFigure.amount,'1900000.25');assert.equal(r.data.summary.ownerDeclaredTurnover,'1800000.00');view=r.data;pass('Reviewed supply figure stored independently from declared turnover');
r=await a.c.json(path,'DELETE',{action:'all',revision:view.revision});assert.equal(r.status,200);const empty=await a.c.json(path);assert.equal(empty.data.imports.length,0);assert.equal(empty.data.transactions.length,0);assert.equal(empty.data.summary.confirmedSupplyFigure,null);assert.equal((await a.c.request(fileUrl)).status,404);pass('Delete all clears files transactions corrections and reviewed figures');
const after=(await a.c.json('/api/workspaces/'+a.w.id)).data.workspace;assert.deepEqual(after.profile,initial.profile);assert.deepEqual(after.events,initial.events);assert.deepEqual(after.tasks,initial.tasks);pass('Financial workflows leave existing profile tasks and business-change history unchanged');
