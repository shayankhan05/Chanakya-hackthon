r=await upload(bytes,'fictional.csv','text/csv',0);assert.equal(r.status,200);assert.equal(r.data.duplicate,true);assert.equal(r.data.revision,view.revision);pass('Repeated import is idempotent, including retry with old revision');
const fileUrl=path+'&file='+importId;assert.equal((await b.c.request(fileUrl)).status,404);const file=await a.c.request(fileUrl);assert.equal(file.status,200);assert.equal(await file.text(),csv);assert.match(file.headers.get('cache-control')||'',/no-store/);pass('Encrypted original download requires ownership');
assert.equal((await a.c.json(path,'PATCH',{action:'confirm',revision:view.revision,importId,changes:view.transactions.map((t:FinancialTransaction)=>({id:t.id,category:t.category})),coverageConfirmed:true})).status,400);pass('Uncertain classifications cannot silently confirm');
