const evidenceWorkspace=(await evidenceResult.json()).workspace,proofDocument=evidenceWorkspace.documents.find((d:{name:string})=>d.name==='fictional-proof.txt');assert.ok(proofDocument);pass('Actual authenticated fictional evidence upload persists metadata');
