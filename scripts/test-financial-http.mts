const boundaryChanges=boundaryView.transactions.map((t:FinancialTransaction)=>({id:t.id,category:t.description.includes('AMBIGUOUS-A')?'Owner investment':t.description.includes('AMBIGUOUS-B')?'Owner withdrawal':t.category}));
const boundaryConfirm=await b.c.json(boundaryPath,'PATCH',{action:'confirm',revision:boundaryView.revision,importId:boundaryView.importId,changes:boundaryChanges,coverageConfirmed:true});assert.equal(boundaryConfirm.status,200);boundaryView=boundaryConfirm.data;
assert.equal(boundaryView.summary.projection.projectedSales,'4275000.00');assert.equal(boundaryView.summary.projection.status,'provisional');assert.deepEqual(boundaryView.summary.projection.monthsUsed,['2026-05','2026-06','2026-07','2026-08']);assert.deepEqual(boundaryView.summary.projection.missingMonths,['2026-04','2026-09']);assert.equal(boundaryView.summary.ownerDeclaredTurnover,'1800000.00');pass('Four complete confirmed months produce the exact INR 42,75,000 provisional annual estimate');
