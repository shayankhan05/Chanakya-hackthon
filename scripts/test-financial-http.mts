const largeOwner=await owner(),largePath='/api/financial-records?businessId='+largeOwner.w.id;
async function inputUpload(text:string,account='Fictional inputs',from='2026-04-01',to='2026-09-30',mime='application/octet-stream',name='fictional-inputs.csv'){
 const body=new FormData();body.set('file',new Blob([text],{type:mime}),name);body.set('consent','yes');body.set('account',account);body.set('from',from);body.set('to',to);body.set('revision','0');const response=await largeOwner.c.request(largePath,{method:'POST',body});return {status:response.status,data:await response.json()};
}
const inputCSV='Posting Date,Particulars,Txn Amount,Debit/Credit,Ref No\n'+Array.from({length:2000},(_,i)=>`01-Apr-2026,Customer invoice fictional ${i},1.25,CR,FICT-${i}`).join('\n');
let inputResult=await inputUpload(inputCSV,'<>');assert.equal(inputResult.status,400);assert.match(inputResult.data.error,/account label/);pass('Invalid account labels receive a field-specific error');
assert.equal((await inputUpload(inputCSV,'Fictional inputs','2026-05-01')).status,400);pass('Statement period outside transaction dates is rejected');
assert.equal((await inputUpload('not a supported bank table')).status,400);pass('Unsupported CSV layouts fail explicitly');
inputResult=await inputUpload(inputCSV);assert.equal(inputResult.status,200);assert.equal(inputResult.data.transactions.length,2000);assert.equal(inputResult.data.imports[0].columnMapping.direction,'Debit/Credit');pass('Actual 2000-row single-amount CR/DR CSV import accepts common headers dates and unknown browser MIME');
const largeReview={action:'confirm',revision:inputResult.data.revision,importId:inputResult.data.importId,coverageConfirmed:true,changes:inputResult.data.transactions.map((t:FinancialTransaction)=>({id:t.id,category:'Customer sales receipt'}))};assert.ok(Buffer.byteLength(JSON.stringify(largeReview))>200000);inputResult=await largeOwner.c.json(largePath,'PATCH',largeReview);assert.equal(inputResult.status,200);assert.equal(inputResult.data.summary.months[0].salesReceipts,'2500.00');pass('All 2000 extracted transactions can be confirmed in one real request above the former JSON size limit');
assert.equal((await largeOwner.c.json(largePath,'PATCH',{padding:'x'.repeat(400001)})).status,413);pass('Oversized financial JSON remains bounded');
assert.equal((await largeOwner.c.json(largePath,'DELETE',{action:'all',revision:inputResult.data.revision})).status,200);
